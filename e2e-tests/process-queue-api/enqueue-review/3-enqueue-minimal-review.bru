meta {
  name: POST Enqueue Minimal Review
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/bond-movie-events/review-updates/enqueue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "catalog_order": 1,
    "title": "Dr. No",
    "review": "<p>The first Bond film.</p>"
  }
}

assert {
  res.status: eq 204
}

tests {
  test("should return 204 No Content", function() {
    expect(res.status).to.equal(204);
  });

  test("should handle minimal review content", function() {
    expect(res.body).to.equal('');
  });
}
